---
const { title = "Karini Zanetti" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <a class="brand" href="/">Karini Zanetti</a>
      <nav>
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/articles">Articles</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <p>© 2026 Karini Zanetti. Brazilian Attorney | Agribusiness Succession and Holding Structures.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --green: #1E3A2B;
    --gold: #B8963E;
    --cream: #F7F5F0;
    --text: #2B2B2B;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: "Inter", sans-serif;
    background: var(--cream);
    color: var(--text);
    line-height: 1.7;
  }
  h1, h2, h3 { font-family: "Playfair Display", serif; color: var(--green); line-height: 1.2; }
  header {
    background: var(--green);
    display: flex; justify-content: space-between; align-items: center;
    padding: 1rem 2rem; flex-wrap: wrap; gap: 1rem;
  }
  header .brand { color: #fff; font-family: "Playfair Display", serif; font-size: 1.4rem; text-decoration: none; }
  header nav a { color: #e9e4d3; text-decoration: none; margin-left: 1.5rem; font-weight: 500; }
  header nav a:hover { color: var(--gold); }
  main { max-width: 960px; margin: 0 auto; padding: 3rem 1.5rem; }
  .hero { padding: 3rem 0; }
  .hero .tag { color: var(--gold); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.85rem; }
  .hero h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.5rem 0 1rem; }
  .button {
    display: inline-block; background: var(--gold); color: #fff;
    padding: 0.8rem 1.6rem; border-radius: 4px; text-decoration: none; font-weight: 600;
  }
  .button:hover { background: #9c7d31; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
  .card { background: #fff; border-top: 4px solid var(--gold); padding: 1.5rem; border-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
  footer { background: var(--green); color: #e9e4d3; text-align: center; padding: 1.5rem; font-size: 0.9rem; }
  footer p { margin: 0; }
</style>